{
  "name": "magpie-freepool",
  "version": "0.1.3",
  "description": "One card, fifteen free-tier AI vendors: paste every key you have once (llm7 needs none) and pick any of their models from magpie. Models route by prefix — llm7/…, groq/…, xkiro/… — each entry pointing at its own upstream.",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "README.md",
    "README-TEMPLATE.md",
    "AGENTS.md",
    "CHECKLIST.md",
    "HOOKS.md",
    "UPDATING.md",
    "CHANGELOG.md",
    "MULTI-PROVIDER.md",
    "NOTICE.md",
    "LICENSE",
    "extract-contract.py",
    "registry-entry.json",
    "tests",
    "scripts",
    "examples",
    "ERROR-CODES.md",
    "RECYCLING.md",
    "GUIDE.md",
    "OFFICIAL-SOURCES.md",
    "SCORING.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "provider",
    "auth",
    "free",
    "free-tier",
    "aggregate",
    "gateway",
    "llm7",
    "nararoute",
    "xkiro",
    "sambanova",
    "cohere",
    "huggingface",
    "cloudflare",
    "groq",
    "mistral",
    "gemini",
    "openrouter",
    "kilo",
    "opencode-zen",
    "ollama-cloud",
    "nvidia"
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 4,
    "name": "免费池 FreePool"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "check:errors": "node scripts/check-error-codes.mjs .",
    "check:ua": "node scripts/check-ua.mjs .",
    "create": "node scripts/create.mjs",
    "release": "node scripts/release.mjs",
    "score": "node scripts/score.mjs",
    "maintenance": "node scripts/check-maintenance.mjs",
    "check:actions": "node scripts/check-actions.mjs",
    "publish:npm": "node scripts/publish-npm.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYCF711/magpie-freepool.git"
  },
  "bugs": {
    "url": "https://github.com/MYCF711/magpie-freepool/issues"
  },
  "homepage": "https://github.com/MYCF711/magpie-freepool#readme"
}
